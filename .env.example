# Example environment file. Copy to `.env` and fill in values — never commit `.env`.

# DeepSeek API key used by the harness (chat + web search).
DEEPSEEK_API_KEY=

# GitHub token with repo scope, used by the daily-sync workflow to open PRs.
GH_TOKEN=

# Override the host boot command (default: `dsh web`; the vendored launcher is preferred when present).
DSH_DESKTOP_HOST_CMD=

# Override the web URL probed by scripts/smoke-web.sh (default: http://127.0.0.1:3080/).
DSH_WEB_URL=
